<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Form Feedback - Bagian 2</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container">
    <a class="navbar-link navbar-brand" href="/">App Utama</a>
    <a class="btn btn-outline-light btn-sm" href="/logout">Logout</a>
  </div>
</nav>

<div class="container">
  <div class="card shadow-sm p-4">
    <h2 class="mb-3">Form Feedback (Implementasi Mandiri Bagian 2)</h2>
    <hr>

    <!-- Pesan Error Validasi Server-Side -->
    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <ul class="mb-0">
          <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Form Feedback -->
    <form action="/feedback" method="POST" class="mb-4">
      <div class="mb-3">
        <label for="message" class="form-label font-weight-bold">Tulis Pesan Feedback Anda:</label>
        <textarea name="message" id="message" class="form-control" rows="3" placeholder="Masukkan masukan Anda di sini..."><%= oldInput.message || '' %></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Kirim Feedback</button>
    </form>

    <hr>

    <h3>Daftar Feedback</h3>
    <div class="list-group">
      <% if (feedbacks.length === 0) { %>
        <p class="text-muted">Belum ada feedback yang dikirim.</p>
      <% } else { %>
        <% feedbacks.forEach(item => { %>
          <div class="list-group-item">
            <!-- AMAN dari XSS: Menggunakan <%= %> untuk auto-escape HTML -->
            <h5 class="mb-1 text-primary"><%= item.username %></h5>
            <p class="mb-1"><%= item.message %></p>
            <small class="text-muted"><%= item.createdAt %></small>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

</body>
</html>